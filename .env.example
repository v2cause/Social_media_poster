# Local development configuration.
#
# Copy this file to .env before the first `docker compose up`:
#   cp .env.example .env
#
# The values below are for local use only. Every other environment needs its own secrets.
# Groups are added as the guide reaches them; this file currently covers the local infrastructure.

# --- Database (compose.yaml) -------------------------------------------------
POSTGRES_PASSWORD=change-me-postgres
APP_MIGRATOR_PASSWORD=change-me-app-migrator
APP_USER_PASSWORD=change-me-app-user
APP_SYSTEM_PASSWORD=change-me-app-system

# --- S3-compatible storage (compose.yaml) ------------------------------------
# The access key pair must match infra/docker/seaweedfs/s3.json.
S3_ACCESS_KEY_ID=smp-local-access-key
S3_SECRET_ACCESS_KEY=smp-local-secret-key
S3_REGION=us-east-1
S3_BUCKET=smp-media
