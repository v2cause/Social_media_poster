# Local development configuration.
#
# Copy this file to .env before the first start:
#   cp .env.example .env
#
# Then generate the secrets marked "pnpm gen:keys" and paste them in.
# Values marked "change-me" are for local use only. Every other environment needs its own secrets.
# With NODE_ENV=production the API and the worker refuse them, and http for the URLs the browser
# and the recipients of emails get, unless APP_URL points at this machine (compose profile "app").
# Never prefix a secret with NEXT_PUBLIC_. Only the web app may read NEXT_PUBLIC_* variables.

# --- Local infrastructure (compose.yaml) -------------------------------------
# Required by `docker compose up`. The database URLs below must use the same passwords.
POSTGRES_PASSWORD=change-me-postgres
APP_MIGRATOR_PASSWORD=change-me-app-migrator
APP_USER_PASSWORD=change-me-app-user
APP_SYSTEM_PASSWORD=change-me-app-system
# The Redis user of the browser worker (compose profile "xb"), which reaches only the X browser.
XB_REDIS_PASSWORD=change-me-xb-redis
# Redis user of API and worker; REDIS_URL below must carry the same password.
REDIS_APP_PASSWORD=change-me-redis-app

# --- App (required) ----------------------------------------------------------
NODE_ENV=development
# The origin of the web app: the API accepts writes from it only, and the notification emails of
# the worker role "notify" link to it.
APP_URL=http://localhost:3000
API_PORT=3001
API_INTERNAL_URL=http://127.0.0.1:3001
LOG_LEVEL=info

# --- Database (required) -----------------------------------------------------
# app_user: runtime role, subject to RLS. Never use the table owner at runtime.
DATABASE_URL=postgresql://app_user:change-me-app-user@127.0.0.1:5432/smp
# app_system: BYPASSRLS, only for repository methods marked @SystemScope(). The API and the worker
# role "scheduler" (ticks, outbox relay, re-wrap of secrets) need it.
DATABASE_SYSTEM_URL=postgresql://app_system:change-me-app-system@127.0.0.1:5432/smp
# app_migrator: owns the schema, used only by `pnpm db:migrate`.
MIGRATION_DATABASE_URL=postgresql://app_migrator:change-me-app-migrator@127.0.0.1:5432/smp
# Shadow database for `pnpm db:migrate` (prisma migrate dev). Created by compose.yaml.
MIGRATION_SHADOW_DATABASE_URL=postgresql://app_migrator:change-me-app-migrator@127.0.0.1:5432/smp_shadow
# Password of the demo users from `pnpm db:seed` (owner@, admin@, editor@, viewer@demo.local).
# Local development only; the seed refuses to run with NODE_ENV=production.
SEED_USER_PASSWORD=change-me-demo-password

# --- Redis, S3 and mail (required) -------------------------------------------
REDIS_URL=redis://app:change-me-redis-app@127.0.0.1:6379
# Local SeaweedFS. The key pair must match infra/docker/seaweedfs/s3.json.
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=smp-media
S3_ACCESS_KEY_ID=smp-local-access-key
S3_SECRET_ACCESS_KEY=smp-local-secret-key
S3_FORCE_PATH_STYLE=true
# Optional: the storage address the browser reaches, when it differs from S3_ENDPOINT (for example
# inside Docker). Presigned upload and preview URLs are signed for it, and the web app allows its
# origin (else the one of S3_ENDPOINT) in img-src and connect-src of its CSP.
S3_PUBLIC_ENDPOINT=
# The media storage and the days of analytics of an organization come from its plan (guide step
# 7.4): uploads beyond it get STORAGE_QUOTA_EXCEEDED, earlier periods ANALYTICS_HISTORY_EXCEEDED.
# Base URL for public media links. Instagram fetches images from a public URL.
PUBLIC_MEDIA_BASE_URL=http://127.0.0.1:8333/smp-media
# Local Mailpit. Mails are visible in its UI on http://127.0.0.1:8025.
# The worker role "notify" sends every email; the API only queues them.
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=noreply@localhost

# --- Auth and encryption (required, generate with `pnpm gen:keys`) ----------
# BETTER_AUTH_SECRET: at least 32 characters. BETTER_AUTH_URL: the origin the browser uses (APP_URL).
# TOKEN_KEKS and SESSION_KEKS: "<key-id>:<base64 32-byte key>", comma-separated for rotation.
# *_KEK_ACTIVE: the key id that encrypts new data.
BETTER_AUTH_SECRET=
# Rotation (docs/runbooks/secret-rotation.md): "<version>:<secret>", comma-separated, the current
# one first; BETTER_AUTH_SECRET then opens what was encrypted before. Empty: BETTER_AUTH_SECRET alone.
BETTER_AUTH_SECRETS=
BETTER_AUTH_URL=http://localhost:3000
TOKEN_KEKS=
TOKEN_KEK_ACTIVE=
SESSION_KEKS=
SESSION_KEK_ACTIVE=
# Breach check of new passwords: only five hex characters of their SHA-1 leave the API. Empty
# turns it off (development, tests); production needs https://api.pwnedpasswords.com or a mirror.
PWNED_PASSWORDS_API_URL=

# --- AI (optional, the mock provider needs no key) ---------------------------
# AI_PROVIDER: "mock" or "anthropic". The mock is refused in production, which includes the
# containers of the compose profile "app" (NODE_ENV=production).
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Effort per route. Each route keeps its own value so the prompt cache stays valid.
AI_EFFORT_GENERATE=medium
AI_EFFORT_REFINE=low
AI_EFFORT_IDEAS=medium
AI_EFFORT_ALT_TEXT=low
AI_REFUSAL_FALLBACK=true
# The monthly AI usage of an organization comes from its plan: credits and overage (guide step 7.4).
# Budget of one run of the AI eval suite (pnpm eval:ai) in micro-USD; without it the eval does
# not start. The full suite is estimated at no more than about 2 USD (ADR 0018).
EVAL_BUDGET_MICROS=

# --- Platforms (optional, "mock" needs no credentials) -----------------------
# PLATFORM_MODE_*: "mock" or "live"; META covers Facebook and Instagram. Mock platforms connect
# through the fake OAuth page /api/dev/mock-oauth/authorize and are not offered in production.
# PUBLISH_DRY_RUN=true: live adapters refresh tokens and validate, but send nothing.
PLATFORM_MODE_LINKEDIN=mock
PLATFORM_MODE_META=mock
PLATFORM_MODE_X=mock
PUBLISH_DRY_RUN=true
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CM_CLIENT_ID=
LINKEDIN_CM_CLIENT_SECRET=
# Format YYYYMM. Check against the LinkedIn docs when the adapter is built (phase 4).
LINKEDIN_VERSION=
META_APP_ID=
META_APP_SECRET=
# Check against the Meta docs when the adapter is built (phase 4).
META_GRAPH_VERSION=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Worker (optional, defaults apply) ---------------------------------------
# Comma-separated roles: scheduler, publisher, analytics, media, ai, notify, billing, gdpr. Add
# "billing" once Stripe is set up below; it refuses to start without STRIPE_SECRET_KEY. "gdpr"
# runs the data exports and the erasures of deleted organizations and needs DATABASE_SYSTEM_URL,
# APP_URL, the S3 settings and TOKEN_KEKS above (to revoke the grants at the platforms); with
# STRIPE_SECRET_KEY it also deletes the customer of an erased organization at Stripe.
WORKER_ROLES=scheduler,publisher,analytics,media,ai,notify,gdpr
# Interval of tick.publish in ms; 2000 for time-lapse tests (architecture 16).
SCHEDULER_TICK_MS=15000
# The role "publisher": publish jobs at once per process; the lock of a running job in ms, after
# which the job of a stopped worker is taken over; the lease of a publish run in ms (5 minutes).
PUBLISH_CONCURRENCY=5
PUBLISH_LOCK_MS=30000
PUBLISH_LEASE_MS=300000
# Port for /health/live, /health/ready and /metrics of the worker.
WORKER_HEALTH_PORT=3002
# Speeds the polling cascade of the post metrics up (roles publisher and analytics): 60 turns an
# hour into a minute for time-lapse tests (architecture 16); 1 in production.
ANALYTICS_CADENCE_SCALE=1
# The deployment runs the browser worker of the optional X browser (phase 6), read by API, worker
# and browser worker. Off, the X browser is off everywhere; on, platform admins still have to allow
# an organization and a workspace has to switch it on. The kill switch of the admins is a flag.
# On, API and browser worker need SESSION_KEKS: the API seals the credentials and codes of a login
# of X with it, and only the browser worker opens them. The worker role "publisher" then needs
# DATABASE_SYSTEM_URL and APP_URL as well: its circuit breaker switches the global flag off after
# three drifts of the selector map in an hour and emails the platform admins (guide step 6.5).
FEATURE_X_BROWSER_GLOBAL=false
# The browser worker reads only REDIS_URL, FEATURE_X_BROWSER_GLOBAL, SESSION_KEKS, XB_EGRESS_* and
# XB_CONCURRENCY; it never gets database or storage credentials. XB_EGRESS_HOSTS: the origins of the
# media storage it may reach on top of the hosts of X, comma-separated (the origin of
# S3_PUBLIC_ENDPOINT). XB_EGRESS_PROXY: the egress proxy of the network (compose profile "xb"),
# empty in development. XB_CONCURRENCY: commands at a time, 1 or 2.
XB_EGRESS_HOSTS=http://127.0.0.1:8333
XB_EGRESS_PROXY=
XB_CONCURRENCY=1
# The internal test account of X (its id in the app, connected through the browser) that the role
# "scheduler" runs the daily canary of the selector map with; empty, no canary runs.
XB_CANARY_ACCOUNT_ID=

# --- Billing and operations (optional, empty disables the feature) -----------
# Stripe (guide step 7.2): the secret key for the API and the worker roles "billing" and "gdpr",
# and the signing secret of the webhook endpoint /api/webhooks/stripe for the API; both or neither. The
# role "billing" also needs DATABASE_SYSTEM_URL (Stripe names customers, not tenants) and APP_URL
# (the links of its emails to the owners).
# Prices, meters and the portal come from `pnpm stripe:sync` (tools/stripe-sync.ts).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The fake Stripe of the tests and the local end-to-end run (test keys only, never in production).
STRIPE_API_BASE=
SENTRY_DSN=
# With the compose profile "observability" use http://127.0.0.1:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- End-to-end tests (optional, read by apps/web/playwright.config.ts) -----
# Must match APP_URL exactly; the API accepts writes only from that origin.
# E2E_BASE_URL=http://localhost:3000
# A preinstalled Chrome or Chromium instead of Playwright's own download, also for the browser
# worker and its integration tests.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/usr/bin/google-chrome
# The billing test (apps/web/e2e/billing.spec.ts) needs the stack with the fake Stripe:
# STRIPE_SECRET_KEY=sk_test_e2e, STRIPE_WEBHOOK_SECRET=whsec_e2e, STRIPE_API_BASE=http://127.0.0.1:12111
# and "billing" in WORKER_ROLES. E2E_SHOTS_DIR keeps screenshots of the states it passes.
# E2E_SHOTS_DIR=
# A test key of a Stripe account in test mode for the optional run against its test clocks
# (apps/worker/test/stripe-test-clock.integration.test.ts); never a live key.
# STRIPE_TEST_CLOCK_SECRET_KEY=
