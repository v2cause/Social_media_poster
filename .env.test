# Test configuration. Committed on purpose: it holds test values only, never real secrets.
#
# Integration tests start their own Postgres and Redis with Testcontainers and set the
# database and Redis URLs themselves, so no database URL is listed here.

NODE_ENV=test
LOG_LEVEL=silent
APP_URL=http://localhost:3000
API_PORT=3101
BETTER_AUTH_SECRET=test-only-better-auth-secret-do-not-use-elsewhere
BETTER_AUTH_URL=http://localhost:3000
TOKEN_KEKS=test-kek:c21wLXRlc3Qta2VrLW1hdGVyaWFsLTAwMDAwMDAwMDA=
TOKEN_KEK_ACTIVE=test-kek
SESSION_KEKS=test-kek:c21wLXRlc3Qta2VrLW1hdGVyaWFsLTAwMDAwMDAwMDA=
SESSION_KEK_ACTIVE=test-kek
AI_PROVIDER=mock
PLATFORM_MODE_LINKEDIN=mock
PLATFORM_MODE_META=mock
PLATFORM_MODE_X=mock
PUBLISH_DRY_RUN=true
FEATURE_X_BROWSER_GLOBAL=false
