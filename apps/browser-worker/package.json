{
  "name": "@smp/browser-worker",
  "version": "0.0.0",
  "private": true,
  "description": "Isolated Playwright host for the optional X browser adapter. Consumes only xb-commands.",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@smp/observability": "workspace:*",
    "bullmq": "^5.81.5",
    "ioredis": "^5.11.1",
    "playwright": "1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@smp/config": "workspace:*",
    "@types/node": "^24.19.2",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
