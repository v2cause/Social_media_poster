{
  "name": "@smp/egress-proxy",
  "version": "0.0.0",
  "private": true,
  "description": "Forward proxy of the browser worker: lets it reach only the X web app and the media storage.",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/main.js",
