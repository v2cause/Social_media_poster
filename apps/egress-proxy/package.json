  },
  "dependencies": {
    "@smp/observability": "workspace:*",
    "@smp/x-browser": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@smp/config": "workspace:*",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
