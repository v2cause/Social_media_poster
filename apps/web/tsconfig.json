{
  "extends": "@smp/config/tsconfig.next.json",
  "compilerOptions": {
    "allowJs": false,
    "incremental": false,
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "playwright.config.ts",
    "playwright.staging.config.ts",
    "vitest.config.mts",
    "e2e/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
