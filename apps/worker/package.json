{
  "name": "@smp/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background worker: BullMQ processors selected by WORKER_ROLES, health and metrics",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=../../.env --require @smp/observability/register\"",
    "start": "node --require @smp/observability/register dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@smp/core": "workspace:*",
    "@smp/db": "workspace:*",
    "@smp/emails": "workspace:*",
    "@smp/media": "workspace:*",
    "@smp/observability": "workspace:*",
    "@smp/queue": "workspace:*",
    "bullmq": "^5.81.5",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@nestjs/cli": "^11.0.24",
    "@smp/config": "workspace:*",
    "@smp/testing": "workspace:*",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
