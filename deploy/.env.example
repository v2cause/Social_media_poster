# Settings of the production template (guide step 8.9, ADR 0045). Copy to deploy/.env on the VM
# and fill in. No secret belongs here: every password, key and token is a file in deploy/secrets/,
# which scripts/init-secrets.sh creates (docs/runbooks/deployment.md).

# --- Parts of the template ---------------------------------------------------
# Compose profiles, comma-separated: backup (the copy off the VM; production needs it), monitoring
# and xb (the browser of X, with compose.xb.yaml).
SMP_PROFILES=backup,monitoring
# Billing with Stripe (compose.billing.yaml); its keys lie in deploy/secrets/.
SMP_BILLING=false
# A staging on one machine (compose.staging.yaml); never in production.
SMP_STAGING=false
# How the disks with the volumes are encrypted: "luks" (preflight checks the device) or
# "provider" (the provider of the VM encrypts them; check its documentation).
SMP_DISK_ENCRYPTION=luks
# Check the signatures of the images before the start; false only for images built on the VM.
SMP_VERIFY_IMAGES=true

# --- Names and TLS -----------------------------------------------------------
# The origin of the app and the one of the object storage, which the browser uploads to and the
# platforms fetch images from. Both need DNS records pointing at the VM.
SMP_DOMAIN=app.example.com
SMP_MEDIA_DOMAIN=media.example.com
# The tls directive of Caddy for both names: the e-mail address of the ACME account, with which
# Caddy gets certificates of a public CA and renews them; "internal" for the certificates of
# Caddy's own CA, only for a staging without public names.
SMP_TLS=ops@example.com

# --- Network -----------------------------------------------------------------
# The first three numbers of the subnet of the internal network "edge", in which the replicas of
# the API have fixed addresses (.11 and .12). Change it only when it collides with a network the
# VM already uses.
SMP_EDGE_PREFIX=172.30.10

# --- Images ------------------------------------------------------------------
# The signed images of a release (docs/runbooks/deployment.md checks the signature before the
# start). The tag names a release, never "latest".
SMP_REGISTRY=ghcr.io/v2cause/social_media_poster
SMP_VERSION=

# --- App ---------------------------------------------------------------------
MAIL_FROM=noreply@example.com
# The model of the Claude API (packages/ai); production needs the key in deploy/secrets/.
AI_MODEL=claude-opus-5-5
# Mock in production means no adapter. "live" takes the real adapter with the app of the platform
# (docs/betrieb/plattformen-einrichten.md): scripts/deploy.sh adds compose.linkedin.yaml,
# compose.meta.yaml (and compose.instagram.yaml with INSTAGRAM_APP_ID) or compose.x.yaml. The
# client secrets lie in deploy/secrets/; the egress needs the hosts of the platforms (below).
PLATFORM_MODE_LINKEDIN=mock
PLATFORM_MODE_META=mock
PLATFORM_MODE_X=mock
LINKEDIN_CLIENT_ID=
# Format YYYYMM.
LINKEDIN_VERSION=
LINKEDIN_ORGANIZATIONS=false
LINKEDIN_MEMBER_ANALYTICS=false
META_APP_ID=
# Format vNN.0.
META_GRAPH_VERSION=
META_LOGIN_CONFIG_ID=
INSTAGRAM_APP_ID=
X_CLIENT_ID=
# The browser of X (phase 6) runs with the compose profile "xb" only.
FEATURE_X_BROWSER_GLOBAL=false
LOG_LEVEL=info
# Error reports, empty turns them off. Sentry keeps them as its project setting says; 30 days at
# most (ADR 0045).
SENTRY_DSN=
# Traces, empty turns them off. The backend behind it keeps them 30 days at most (ADR 0045).
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Egress ------------------------------------------------------------------
# The hosts API and worker may reach through their egress proxy, comma-separated: hosts on port
# 443, *.subdomains and host:port for SMTP. The SMTP server of SMTP_URL, the ingest host of
# SENTRY_DSN and the APIs of live platforms belong here as well:
# - LinkedIn: api.linkedin.com,www.linkedin.com
# - Meta: graph.facebook.com (Facebook), graph.instagram.com,api.instagram.com (Instagram)
# - X: api.x.com
# - the name of SMP_MEDIA_DOMAIN: the worker reads the images for LinkedIn, Facebook and X there.
SMP_EGRESS_HOSTS=api.anthropic.com,api.stripe.com,api.pwnedpasswords.com,smtp.example.com:465
# The SMTP server outside the network goes through the same proxy; empty for one inside it.
SMP_SMTP_PROXY=http://egress-app:3128

# --- Logs --------------------------------------------------------------------
# journald keeps the logs of every container for 30 days (host/journald.conf). "local" only for
# a staging without journald, which keeps 100 MB per container instead.
SMP_LOG_DRIVER=journald

# --- Monitoring (compose profile "monitoring") -------------------------------
# Alertmanager mails every alert. The password of the SMTP account is a file in deploy/secrets/.
ALERT_SMTP_SMARTHOST=smtp.example.com:465
ALERT_SMTP_USER=alerts@example.com
ALERT_FROM=alerts@example.com
ALERT_TO=operations@example.com
# The CA Alertmanager trusts for the SMTP server, empty for the CAs of the system. Only a staging
# names one: /run/configs/internal-ca.crt, the private CA of Mailpit (compose.staging.yaml).
ALERT_SMTP_CA_FILE=

# --- Backups (compose profile "backup") --------------------------------------
# A bucket of its own outside the VM, with versioning and expiry; its keys are files in
# deploy/secrets/. BACKUP_S3_SSE asks the storage to encrypt every object (AES256 or aws:kms).
BACKUP_S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
BACKUP_S3_REGION=eu-central-1
BACKUP_S3_BUCKET=smp-backups
BACKUP_S3_SSE=AES256
BACKUP_KEEP=7
BACKUP_INTERVAL_HOURS=24
BACKUP_SYNC_SECONDS=300
# The backup jobs report their last success to the Pushgateway of the profile "monitoring".
BACKUP_PUSHGATEWAY_URL=http://pushgateway:9091
