# The reverse proxy of the production template (guide step 8.9, ADR 0045). Caddy is the only
# service with published ports. It terminates TLS 1.2 and 1.3 with certificates of a public CA
# (ACME, renewed by Caddy) or, for a staging without public names, of its own CA (SMP_TLS
# internal), redirects http to https and sends HSTS. API, web app and storage sit in internal
# networks behind it, so X-Real-IP comes from here alone (ADR 0006).
{
	admin off
	servers {
		timeouts {
			# A hard limit on reading a whole request body, also the PUT of a medium into the
			# storage: its link holds five minutes, and media.drop-upload removes the upload
			# object 65 minutes after the ticket (ADR 0039). No PUT outlives that.
			read_body 15m
			read_header 10s
			idle 2m
		}
	}
}

(headers) {
	# One year, every subdomain; the web app sends the same header itself.
	header ?Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header -Server
}

{$SMP_DOMAIN} {
	tls {$SMP_TLS}
	import headers

	# Only the methods the app answers reach it (pentest of guide step 8.4).
	@unsupported not method GET HEAD POST PUT PATCH DELETE OPTIONS

	# The readiness check asks every dependency; the containers and the monitoring call it
	# inside the networks, the internet does not. Caddy runs handle blocks before respond and
	# picks the most specific path first, so this one comes before /api/*.
	handle /api/health/ready* {
		respond 404
	}

	handle /api/* {
		header @unsupported Allow "GET, HEAD, POST, PUT, PATCH, DELETE, OPTIONS"
		respond @unsupported 405
		# Uploads go straight to the storage; the API takes JSON of at most 1 MB.
		request_body {
			max_size 1MB
		}
		reverse_proxy api-1:3001 api-2:3001 {
			# Long-lived streams (server-sent events) spread over both replicas.
			lb_policy least_conn
			lb_try_duration 5s
			health_uri /api/health/live
			health_interval 10s
			health_timeout 3s
			health_status 2xx
			fail_duration 30s
			# Server-sent events reach the browser at once.
			flush_interval -1
			# Overwritten, never appended: a client cannot choose its address (ADR 0006).
			header_up X-Real-IP {remote_host}
			header_up -Forwarded
		}
	}

	handle {
		header @unsupported Allow "GET, HEAD, POST, PUT, PATCH, DELETE, OPTIONS"
		respond @unsupported 405
		# The web app takes forms and server actions only.
		request_body {
			max_size 1MB
		}
		reverse_proxy web:3000 {
			header_up X-Real-IP {remote_host}
			header_up -Forwarded
		}
	}
}

# Plain http (ASVS 4.1.2): only the pages of the app move to https. The API and the storage
# answer 403 instead of a redirect, so a client that sends a request over http learns it at once
# instead of following the redirect. Caddy answers the ACME challenges on port 80 before these.
http://{$SMP_DOMAIN} {
	header -Server
	handle /api/* {
		respond 403
	}
	handle {
		redir https://{host}{uri} 308
	}
}

http://{$SMP_MEDIA_DOMAIN} {
	header -Server
	respond 403
}

# The object storage as browsers and platforms reach it: presigned PUTs of the uploads and
# presigned GETs of previews, renditions and exports. The signature names this host, which Caddy
# keeps in the Host header.
{$SMP_MEDIA_DOMAIN} {
	tls {$SMP_TLS}
	import headers

	@unsupported not method GET HEAD PUT OPTIONS
	respond @unsupported 405

	# 20 MB per file (packages/platform-rules); the storage checks the signed length itself.
	request_body {
		max_size 21MB
	}
	reverse_proxy https://s3:8333 {
		transport http {
			tls_trusted_ca_certs /etc/caddy/internal-ca.crt
			tls_server_name s3
		}
	}
}
