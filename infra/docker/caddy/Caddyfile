# Local reverse proxy for the compose profile "app". It routes like production: one origin, /api
# goes straight to the API, everything else to the web app. The web image therefore contains no
# rewrite to the API, and server-sent events are not buffered by Next.js.
{
	admin off
}

:8080 {
	handle /api/* {
		# Uploads go straight to the object storage; the API takes JSON of at most 1 MB, and
		# /api/auth at most 64 KB (guide step 8.4).
		request_body {
			max_size 1MB
		}
		reverse_proxy api:3001 {
			# Server-sent events (AI generation, live updates) must reach the browser at once.
			flush_interval -1
			# The client address for the auth rate limits. Overwritten, never appended, so a
			# client cannot choose it (ADR 0006).
			header_up X-Real-IP {remote_host}
			# Forwarded names whatever client the client claims to be; tracing would take it as
			# the client address (guide step 8.4). X-Forwarded-For is set by Caddy itself.
			header_up -Forwarded
		}
	}

	handle {
		# The web app takes forms and server actions only.
		request_body {
			max_size 1MB
		}
		reverse_proxy web:3000 {
			# The web app hands the client address on to the API with its own requests, for the
			# inbound rate limits (guide step 8.4); overwritten here as well.
			header_up X-Real-IP {remote_host}
			header_up -Forwarded
		}
	}
}
