{
  "name": "social-media-poster",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --env-mode=loose",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tools/tsconfig.json",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "db:migrate": "pnpm --filter @smp/db migrate:dev",
    "db:seed": "pnpm --filter @smp/db seed",
    "format": "prettier --write .",
    "gen:keys": "tsx tools/gen-keys.ts",
    "check:deps": "depcruise --config .dependency-cruiser.cjs apps packages",
    "check:emoji": "tsx tools/check-no-emoji.ts",
    "check:format": "prettier --check ."
  },
  "prettier": "@smp/config/prettier",
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@smp/config": "workspace:*",
    "@smp/db": "workspace:*",
    "@tanstack/react-query": "^5.104.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "^17.4.3",
    "orval": "^8.43.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.11.8",
    "typescript": "^5.9.3"
  }
}
