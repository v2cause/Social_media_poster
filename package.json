{
  "name": "social-media-poster",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.7+sha512.ba98abc585539933375b5971f4bc6d6c73a1b4b7edc4a879e7d102fe5423d1e02309d67c60a11f04955093a96e521ad9c3b138cdd654ca5be563f378b3ae48bd",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --env-mode=loose",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tools/tsconfig.json && tsc --noEmit -p tools/load/tsconfig.json",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "db:migrate": "pnpm --filter @smp/db migrate:dev",
    "db:seed": "pnpm --filter @smp/db seed",
    "eval:ai": "turbo run build --filter=@smp/ai && pnpm --filter @smp/ai eval",
    "format": "prettier --write .",
    "gen:keys": "tsx tools/gen-keys.ts",
    "check:deps": "depcruise --config .dependency-cruiser.cjs apps packages",
    "check:emoji": "tsx tools/check-no-emoji.ts",
    "check:format": "prettier --check .",
    "check:i18n": "tsx tools/check-i18n.ts",
    "check:rls": "tsx --env-file-if-exists=.env tools/check-rls.ts",
    "check:erasure": "tsx --env-file-if-exists=.env tools/check-erasure.ts",
    "load:fixture": "tsx --env-file-if-exists=.env tools/load-fixture.ts",
    "auth:reencrypt": "pnpm --filter @smp/api auth:reencrypt",
    "auth:revoke-sessions": "pnpm --filter @smp/api auth:revoke-sessions",
    "stripe:sync": "tsx --env-file-if-exists=.env tools/stripe-sync.ts"
  },
  "prettier": "@smp/config/prettier",
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@formatjs/icu-messageformat-parser": "^3.5.21",
    "@smp/billing": "workspace:*",
    "@smp/config": "workspace:*",
    "@smp/core": "workspace:*",
    "@smp/db": "workspace:*",
    "@smp/media": "workspace:*",
    "@tanstack/react-query": "^5.104.3",
    "@types/k6": "2.3.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "^17.4.3",
    "orval": "^8.43.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.11.8",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  }
}
