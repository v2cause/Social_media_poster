{
  "name": "@smp/ai",
  "version": "0.0.0",
  "private": true,
  "description": "AI provider port with the Anthropic adapter, prompts and output schemas.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@smp/config": "workspace:*",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@smp/core": "workspace:*",
    "@smp/platform-rules": "workspace:*",
    "partial-json": "^0.1.7",
    "zod": "^4.6.7"
  }
}
