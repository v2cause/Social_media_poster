{
  "name": "@smp/ai",
  "version": "0.0.0",
  "private": true,
  "description": "The AI providers (Claude API and mock), prompts, output schemas and AI settings.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "node --env-file-if-exists=../../.env dist/eval/run-eval.js"
  },
  "devDependencies": {
    "@smp/config": "workspace:*",
    "@smp/db": "workspace:*",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "msw": "^3.0.3",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@smp/core": "workspace:*",
    "@smp/platform-rules": "workspace:*",
    "partial-json": "^0.1.7",
    "zod": "^4.6.7"
  }
}
