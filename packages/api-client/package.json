{
  "name": "@smp/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed API client generated from the OpenAPI document (TanStack Query hooks).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "build": "orval --config orval.config.ts",
    "dev": "orval --config orval.config.ts",
    "generate": "orval --config orval.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.3",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@smp/config": "workspace:*",
    "@tanstack/react-query": "^5.104.3",
    "@types/react": "^19.3.0",
    "eslint": "^10.12.0",
    "orval": "^8.43.0",
    "react": "^19.3.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
