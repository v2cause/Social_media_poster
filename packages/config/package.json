{
  "name": "@smp/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript, ESLint, Prettier and Vitest presets for the workspace",
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.lib.json": "./tsconfig.lib.json",
    "./tsconfig.nest.json": "./tsconfig.nest.json",
    "./tsconfig.next.json": "./tsconfig.next.json",
    "./eslint": "./eslint.config.js",
    "./prettier": "./prettier.config.js",
    "./vitest": "./vitest.base.ts",
    "./vitest-nest": "./vitest.nest.ts"
  },
  "scripts": {
    "lint": "eslint --config eslint.self.config.mjs .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.1",
    "@swc/core": "^1.16.18",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.4"
  }
}
