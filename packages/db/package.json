{
  "name": "@smp/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema, migrations, database client and seed",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "tsup",
    "dev": "prisma generate && tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "prisma db seed"
  },
  "devDependencies": {
    "@smp/config": "workspace:*",
    "@smp/crypto": "workspace:*",
    "@smp/testing": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.4",
    "better-auth": "^1.7.9",
    "dotenv": "^18.0.8",
    "eslint": "^10.12.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.0",
    "testcontainers": "^12.2.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@smp/core": "workspace:*",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  }
}
