// Prisma schema for the database package.
// Tables arrive with the guide steps that need them (identity and tenancy since step 1.1).
// Row-level security policies, partial indexes and other SQL-only parts are SQL migrations.
//
// Conventions (guide B.1, architecture 6.1): models in PascalCase, columns and tables in
// snake_case via @map/@@map, ids are UUID v7, timestamps are timestamptz.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  // Partial indexes for the scheduler and the analytics planner (architecture 6.2). With the
  // preview feature they live in this schema, so later migrations do not drop them as drift.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------------------------
// Identity: the tables of Better Auth (core schema, two-factor plugin, database rate limit).
// Field names follow Better Auth; ids are generated by the app as UUID v7.
// These tables are global and carry no row-level security.
// ---------------------------------------------------------------------------------------------

model User {
  id               String   @id @db.Uuid
  name             String
  email            String   @unique @db.Citext
  emailVerified    Boolean  @default(false) @map("email_verified")
  image            String?
  twoFactorEnabled Boolean  @default(false) @map("two_factor_enabled")
  locale           String   @default("de")
  timezone         String   @default("Europe/Berlin")
  // Set by platform operators only; Better Auth declares it with input: false.
  isPlatformAdmin  Boolean  @default(false) @map("is_platform_admin")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions                Session[]
  accounts                Account[]
  twoFactors              TwoFactor[]
  memberships             Membership[]
  sentInvitations         Invitation[]             @relation("InvitationInvitedBy")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]

  // "user" is a reserved word in PostgreSQL; raw SQL would need quotes everywhere.
  @@map("users")
}

model Session {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// Better Auth's "account" (a login method). Mapped to auth_account so that it is never
// confused with the social media accounts of phase 4.
model Account {
  id                    String    @id @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_account")
}

model Verification {
  id         String   @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  verified                Boolean   @default(false)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor")
}

// Rate limit counters of the auth routes (Better Auth, storage "database").
model RateLimit {
  id          String @id @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limit")
}

// ---------------------------------------------------------------------------------------------
// Tenancy (architecture 6.2). Tenant keys: organization_id for organizations, memberships,
// invitations and the audit log; workspace_id for workspace content. Every table with such a
// column has row-level security (migration rls_tenancy, checked by tools/check-rls.ts).
// ---------------------------------------------------------------------------------------------

enum MemberRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspaces           Workspace[]
  memberships          Membership[]
  membershipWorkspaces MembershipWorkspace[]
  invitations          Invitation[]
  auditLogs            AuditLog[]
  usageCounters        UsageCounter[]
  usageRecords         UsageRecord[]
  apiCostRecords       ApiCostRecord[]

  @@map("organization")
}

// A brand or client inside an organization. The slug is unique across all organizations,
// because routes address a workspace by slug alone (/w/:ws, ADR 0010).
model Workspace {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  slug            String   @unique
  name            String
  timezone        String
  contentLanguage String   @map("content_language")
  industry        String?
  targetAudience  String?  @map("target_audience")
  goals           String?
  contentPillars  String[] @default([]) @map("content_pillars")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  settings             WorkspaceSettings?
  membershipWorkspaces MembershipWorkspace[]
  postStyles           PostStyle[]
  brandVoices          BrandVoice[]
  brandVoiceVersions   BrandVoiceVersion[]
  ideas                Idea[]
  posts                Post[]
  postVariants         PostVariant[]
  aiGenerations        AiGeneration[]
  usageRecords         UsageRecord[]
  mediaAssets          MediaAsset[]
  mediaRenditions      MediaRendition[]
  postMedia            PostMedia[]
  socialConnections    SocialConnection[]
  socialAccounts       SocialAccount[]
  publishAttempts      PublishAttempt[]
  outboxEvents         OutboxEvent[]
  apiCostRecords       ApiCostRecord[]
  metricSnapshots      MetricSnapshot[]
  postMetricsLatest    PostMetricLatest[]
  accountMetrics       AccountMetricSnapshot[]
  analyticsDaily       AnalyticsDaily[]

  @@index([organizationId])
  @@map("workspace")
}

enum MissedWindowBehavior {
  FAIL
  POST_ANYWAY
}

model WorkspaceSettings {
  workspaceId          String               @id @map("workspace_id") @db.Uuid
  dryRun               Boolean              @default(false) @map("dry_run")
  missedWindowBehavior MissedWindowBehavior @default(FAIL) @map("missed_window_behavior")
  // Per-route overrides of the AI effort, validated with zod in the application.
  effortOverrides      Json?                @map("effort_overrides")
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_settings")
}

model Membership {
  id             String     @id @default(uuid(7)) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  role           MemberRole
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaces   MembershipWorkspace[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("membership")
}

// Restricts a membership to some workspaces. Without rows the member sees every workspace of
// the organization. Owners and admins always see all of them.
model MembershipWorkspace {
  membershipId   String @map("membership_id") @db.Uuid
  workspaceId    String @map("workspace_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([membershipId, workspaceId])
  @@index([workspaceId])
  @@map("membership_workspace")
}

model Invitation {
  id             String     @id @default(uuid(7)) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  email          String     @db.Citext
  role           MemberRole
  // Only the SHA-256 hash of the token is stored; the token itself travels in the email link.
  tokenHash      String     @unique @map("token_hash")
  // Restricts the new membership to these workspaces. Empty means all workspaces.
  workspaceIds   String[]   @default([]) @map("workspace_ids") @db.Uuid
  invitedById    String     @map("invited_by_id") @db.Uuid
  expiresAt      DateTime   @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime?  @map("accepted_at") @db.Timestamptz(3)
  revokedAt      DateTime?  @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// Append-only. app_user has neither UPDATE nor DELETE on this table.
model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  workspaceId    String?  @map("workspace_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  targetType     String   @map("target_type")
  targetId       String?  @map("target_id")
  metadata       Json?
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------------------------
// Notifications (per user) and feature flags.
// ---------------------------------------------------------------------------------------------

model Notification {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  workspaceId    String?   @map("workspace_id") @db.Uuid
  // The outbox event the notification came from (guide step 4.9); one per user and event.
  eventId        String?   @map("event_id") @db.Uuid
  type           String
  payload        Json      @default("{}")
  readAt         DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notification")
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

model NotificationPreference {
  userId  String              @map("user_id") @db.Uuid
  type    String
  channel NotificationChannel
  enabled Boolean             @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type, channel])
  @@map("notification_preference")
}

// Global flags have neither organization nor workspace; kill switches are global flags.
// One row per key and scope is kept by the flag service (phase 6): a unique index over nullable
// columns needs NULLS NOT DISTINCT, which Prisma cannot express and would drop again.
model FeatureFlag {
  id             String   @id @default(uuid(7)) @db.Uuid
  key            String
  organizationId String?  @map("organization_id") @db.Uuid
  workspaceId    String?  @map("workspace_id") @db.Uuid
  enabled        Boolean
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([key])
  @@map("feature_flag")
}

// ---------------------------------------------------------------------------------------------
// Content and AI (guide step 2.1, architecture 6.2). Content tables carry workspace_id, usage
// tables organization_id; all of them have row-level security (migration rls_content_ai).
// Creator and actor columns hold user ids without a foreign key, like audit_log.actor_user_id:
// deleting a user must not delete or block the content of the workspace.
// ---------------------------------------------------------------------------------------------

enum Platform {
  LINKEDIN
  INSTAGRAM
  FACEBOOK
  X
}

// Style presets have no workspace and come from the migration reference_data; custom styles
// belong to one workspace. The prompt names a style by its key, never by its id.
model PostStyle {
  id           String   @id @default(uuid(7)) @db.Uuid
  workspaceId  String?  @map("workspace_id") @db.Uuid
  // Presets: professional, storytelling, casual, educational, thought_leadership, promotional.
  // Custom styles: "custom-" plus a slug of the name, unique per workspace.
  key          String
  name         String
  // The prompt fragment of a preset, or the instructions of a custom style.
  instructions String
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  version      Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts     Post[]

  @@unique([workspaceId, key])
  @@unique([key], map: "post_style_preset_key_key", where: raw("workspace_id IS NULL"))
  @@map("post_style")
}

model BrandVoice {
  id                   String    @id @default(uuid(7)) @db.Uuid
  workspaceId          String    @map("workspace_id") @db.Uuid
  name                 String
  // The version that new generations use. Every change creates a new version.
  currentVersionNumber Int       @map("current_version_number")
  isDefault            Boolean   @default(false) @map("is_default")
  archivedAt           DateTime? @map("archived_at") @db.Timestamptz(3)
  version              Int       @default(0)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions  BrandVoiceVersion[]
  posts     Post[]

  @@index([workspaceId])
  @@map("brand_voice")
}

// Immutable snapshot of a brand voice: the cache key of the brand context in the prompt and the
// reference of every AI generation. app_user may insert and read it, never change or delete it.
model BrandVoiceVersion {
  id            String   @id @default(uuid(7)) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  brandVoiceId  String   @map("brand_voice_id") @db.Uuid
  versionNumber Int      @map("version_number")
  // Name, description, tone, dos and don'ts, vocabulary, forbidden words, emoji and hashtag
  // policy, example posts and language; validated with the zod schema of @smp/contracts.
  content       Json
  // SHA-256 of the canonical JSON of content.
  contentHash   String   @map("content_hash")
  createdById   String?  @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brandVoice    BrandVoice     @relation(fields: [brandVoiceId], references: [id], onDelete: Cascade)
  aiGenerations AiGeneration[]

  @@unique([brandVoiceId, versionNumber])
  @@index([workspaceId])
  @@map("brand_voice_version")
}

enum IdeaStatus {
  NEW
  SAVED
  DISCARDED
  USED
}

enum IdeaSource {
  AI
  MANUAL
}

model Idea {
  id                 String     @id @default(uuid(7)) @db.Uuid
  workspaceId        String     @map("workspace_id") @db.Uuid
  title              String
  angle              String?
  pillar             String?
  whyNow             String?    @map("why_now")
  basedOn            String[]   @default([]) @map("based_on")
  suggestedPlatforms Platform[] @default([]) @map("suggested_platforms")
  suggestedStyleKey  String?    @map("suggested_style_key")
  format             String?
  status             IdeaStatus @default(NEW)
  source             IdeaSource @default(MANUAL)
  aiGenerationId     String?    @map("ai_generation_id") @db.Uuid
  createdById        String?    @map("created_by_id") @db.Uuid
  version            Int        @default(0)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  aiGeneration AiGeneration? @relation(fields: [aiGenerationId], references: [id], onDelete: SetNull)
  posts        Post[]

  @@index([workspaceId, status, createdAt(sort: Desc)])
  // Near-duplicate detection of new idea titles (architecture 5.3, pg_trgm).
  @@index([title(ops: raw("gin_trgm_ops"))], map: "idea_title_trgm_idx", type: Gin)
  @@map("idea")
}

// The master content of a post: brief, style and brand voice. One variant per target.
// The status of a post is derived from its variants (architecture 7.2).
model Post {
  id           String   @id @default(uuid(7)) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  brief        String   @default("")
  // Content language of the variants (de or en).
  language     String
  styleId      String?  @map("style_id") @db.Uuid
  brandVoiceId String?  @map("brand_voice_id") @db.Uuid
  ideaId       String?  @map("idea_id") @db.Uuid
  createdById  String?  @map("created_by_id") @db.Uuid
  version      Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  style         PostStyle?     @relation(fields: [styleId], references: [id], onDelete: SetNull)
  brandVoice    BrandVoice?    @relation(fields: [brandVoiceId], references: [id], onDelete: SetNull)
  idea          Idea?          @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  variants      PostVariant[]
  aiGenerations AiGeneration[]

  @@index([workspaceId, updatedAt(sort: Desc)])
  @@map("post")
}

// Architecture 7.2. Only DRAFT is used before phase 4.
enum VariantStatus {
  DRAFT
  SCHEDULED
  QUEUED
  PUBLISHING
  RETRYING
  PUBLISHED
  FAILED
  NEEDS_ATTENTION
  CANCELED
  DELETED
}

// One variant per target. Carries every field of architecture 6.2, including the scheduling and
// publishing fields of phases 4 and 5, so that phase 4 needed no migration of this table; phase 5
// adds the mark of a post the platform no longer knows.
model PostVariant {
  id                String        @id @default(uuid(7)) @db.Uuid
  workspaceId       String        @map("workspace_id") @db.Uuid
  postId            String        @map("post_id") @db.Uuid
  // The publishing target from phase 4 on.
  socialAccountId   String?       @map("social_account_id") @db.Uuid
  platform          Platform
  // The key of the target in the AI task (t1, t2, ...).
  targetKey         String        @map("target_key")
  text              String        @default("")
  hashtags          String[]      @default([])
  firstComment      String?       @map("first_comment")
  linkUrl           String?       @map("link_url")
  // Hints of the AI such as "the statistic needs a source", shown as warnings.
  aiWarnings        String[]      @default([]) @map("ai_warnings")
  status            VariantStatus @default(DRAFT)
  scheduledAt       DateTime?     @map("scheduled_at") @db.Timestamptz(3)
  scheduledTimezone String?       @map("scheduled_timezone")
  // Raised on every rescheduling; part of the publish job id.
  scheduleVersion   Int           @default(0) @map("schedule_version")
  // Optimistic locking.
  version           Int           @default(0)
  queuedAt          DateTime?     @map("queued_at") @db.Timestamptz(3)
  leaseOwner        String?       @map("lease_owner")
  leaseUntil        DateTime?     @map("lease_until") @db.Timestamptz(3)
  publishedAt       DateTime?     @map("published_at") @db.Timestamptz(3)
  externalPostId    String?       @map("external_post_id")
  externalUrl       String?       @map("external_url")
  failureCode       String?       @map("failure_code")
  lastError         String?       @map("last_error")
  isDryRun          Boolean       @default(false) @map("is_dry_run")
  // Hash of the published content, for the reconcile after an unclear publish attempt.
  contentHash       String?       @map("content_hash")
  metricsNextAt     DateTime?     @map("metrics_next_at") @db.Timestamptz(3)
  metricsStep       Int           @default(0) @map("metrics_step")
  // The platform no longer knows the post (guide step 5.2): its metrics are not polled again.
  externalDeletedAt DateTime?     @map("external_deleted_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  post          Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  // Accounts are disconnected, not deleted; only deleting the workspace removes them.
  socialAccount SocialAccount?    @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  media         PostMedia[]
  attempts      PublishAttempt[]
  snapshots     MetricSnapshot[]
  latestMetrics PostMetricLatest?

  @@unique([postId, targetKey])
  // The calendar asks for the variants of a workspace in a period (guide step 4.11).
  @@index([workspaceId, scheduledAt])
  @@index([socialAccountId])
  @@index([scheduledAt], map: "post_variant_due_idx", where: raw("status = 'SCHEDULED'"))
  @@index([metricsNextAt], map: "post_variant_metrics_due_idx", where: raw("status = 'PUBLISHED'"))
  // The sweeper (guide step 4.7): queued variants without a job, and publishing ones whose lease
  // ran out.
  @@index([queuedAt], map: "post_variant_queued_idx", where: raw("status = 'QUEUED'"))
  @@index([leaseUntil], map: "post_variant_lease_idx", where: raw("status = 'PUBLISHING'"))
  @@map("post_variant")
}

enum AiTask {
  GENERATE
  REFINE
  IDEAS
  ALT_TEXT
  VOICE_TEST
}

enum AiOutcome {
  OK
  REFUSED
  TRUNCATED
  INVALID_OUTPUT
  PROVIDER_ERROR
  CANCELED
}

// Every AI call (architecture 5.3). Written once when the call ends; app_user may insert and read.
model AiGeneration {
  id                  String    @id @default(uuid(7)) @db.Uuid
  workspaceId         String    @map("workspace_id") @db.Uuid
  userId              String?   @map("user_id") @db.Uuid
  task                AiTask
  postId              String?   @map("post_id") @db.Uuid
  brandVoiceVersionId String?   @map("brand_voice_version_id") @db.Uuid
  promptVersion       String    @map("prompt_version")
  provider            String
  modelRequested      String    @map("model_requested")
  // The model that produced the answer (top-level model of the response), after a fallback too.
  modelServed         String?   @map("model_served")
  effort              String
  // The input without the rendered prompt: brief, style, targets, language, refine action.
  input               Json
  output              Json?
  outcome             AiOutcome
  stopReason          String?   @map("stop_reason")
  refusalCategory     String?   @map("refusal_category")
  // Sums over all attempts; the attempts themselves (model, tokens, cost) are in attempts.
  inputTokens         Int       @default(0) @map("input_tokens")
  outputTokens        Int       @default(0) @map("output_tokens")
  cacheReadTokens     Int       @default(0) @map("cache_read_tokens")
  cacheWriteTokens    Int       @default(0) @map("cache_write_tokens")
  attempts            Json      @default("[]")
  costMicros          BigInt    @default(0) @map("cost_micros")
  latencyMs           Int?      @map("latency_ms")
  ttftMs              Int?      @map("ttft_ms")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  post              Post?              @relation(fields: [postId], references: [id], onDelete: SetNull)
  brandVoiceVersion BrandVoiceVersion? @relation(fields: [brandVoiceVersionId], references: [id], onDelete: SetNull)
  ideas             Idea[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("ai_generation")
}

// Atomic quota counter per organization, meter and period (guide step 2.6).
model UsageCounter {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  // For example "ai_micros".
  meter          String
  // First day of the period (UTC).
  periodStart    DateTime @map("period_start") @db.Date
  value          BigInt   @default(0)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, meter, periodStart])
  @@map("usage_counter")
}

// The usage ledger: one row per source and meter, so booking twice changes nothing.
model UsageRecord {
  id                 String    @id @default(uuid(7)) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  workspaceId        String?   @map("workspace_id") @db.Uuid
  meter              String
  // For example "ai_generation" with the id of the AiGeneration.
  sourceType         String    @map("source_type")
  sourceId           String    @map("source_id") @db.Uuid
  quantity           BigInt
  periodStart        DateTime  @map("period_start") @db.Date
  // Set by the billing job of phase 7 after reporting to Stripe.
  reportedToStripeAt DateTime? @map("reported_to_stripe_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@unique([sourceType, sourceId, meter])
  @@index([organizationId, periodStart])
  @@map("usage_record")
}

// Model prices in micro-USD per million tokens, versioned by valid_from. Prices live only
// here, never in code. Global reference data: app_user may read it, not change it.
model PriceBook {
  id                        String   @id @default(uuid(7)) @db.Uuid
  model                     String
  validFrom                 DateTime @map("valid_from") @db.Timestamptz(3)
  inputMicrosPerMtok        BigInt   @map("input_micros_per_mtok")
  outputMicrosPerMtok       BigInt   @map("output_micros_per_mtok")
  cacheReadMicrosPerMtok    BigInt   @map("cache_read_micros_per_mtok")
  cacheWrite5mMicrosPerMtok BigInt   @map("cache_write_5m_micros_per_mtok")
  cacheWrite1hMicrosPerMtok BigInt   @map("cache_write_1h_micros_per_mtok")
  // Where the prices come from and when they were last checked against it.
  source                    String
  checkedAt                 DateTime @map("checked_at") @db.Date
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([model, validFrom])
  @@map("price_book")
}

// ---------------------------------------------------------------------------------------------
// Media (guide step 3.1, architecture 9): uploaded images, their renditions per platform and
// their use in variants. Keyed by workspace, with row-level security.
// ---------------------------------------------------------------------------------------------

enum MediaStatus {
  PENDING_UPLOAD
  PROCESSING
  READY
  REJECTED
}

// An uploaded image. The original stays in storage for the pipeline only; platforms and the
// browser get renditions.
model MediaAsset {
  id               String      @id @default(uuid(7)) @db.Uuid
  workspaceId      String      @map("workspace_id") @db.Uuid
  status           MediaStatus @default(PENDING_UPLOAD)
  // The name of the user's file, for display only; storage keys never contain it.
  fileName         String      @map("file_name")
  // What the browser announced. The pipeline measures the real values and never trusts these.
  declaredMimeType String      @map("declared_mime_type")
  declaredSize     Int         @map("declared_size")
  // ws/{workspaceId}/assets/{id}/original
  storageKey       String      @map("storage_key")
  // Measured by media.process on the normalized original.
  mimeType         String?     @map("mime_type")
  sizeBytes        Int?        @map("size_bytes")
  width            Int?
  height           Int?
  sha256           String?
  // Why the pipeline rejected the file, for example NOT_AN_IMAGE or HEIC_NOT_SUPPORTED.
  rejectReason     String?     @map("reject_reason")
  altText          String?     @map("alt_text")
  uploadedById     String?     @map("uploaded_by_id") @db.Uuid
  version          Int         @default(0)
  processedAt      DateTime?   @map("processed_at") @db.Timestamptz(3)
  // Removed from the library; the objects are deleted after 30 days.
  deletedAt        DateTime?   @map("deleted_at") @db.Timestamptz(3)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  renditions MediaRendition[]
  postMedia  PostMedia[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("media_asset")
}

// A derived image: a thumbnail or the version of an asset for a platform, with its crop.
model MediaRendition {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  assetId     String   @map("asset_id") @db.Uuid
  // A profile of @smp/platform-rules, for example instagram_feed or thumb_320.
  profile     String
  // The hash of crop and fit; "full" for the whole image.
  cropHash    String   @map("crop_hash")
  storageKey  String   @map("storage_key")
  mimeType    String   @map("mime_type")
  width       Int
  height      Int
  sizeBytes   Int      @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  asset     MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, profile, cropHash])
  @@index([workspaceId])
  @@map("media_rendition")
}

// An image of a variant, in order, with the crop and alt text for that variant's platform.
model PostMedia {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  variantId   String   @map("variant_id") @db.Uuid
  assetId     String   @map("asset_id") @db.Uuid
  position    Int
  // { x, y, width, height } in pixels of the original, or null for the whole image.
  crop        Json?
  // Bars instead of a crop where the image does not fit the aspect ratio of the platform.
  letterbox   Boolean  @default(false)
  // The alt text of this use; null takes the alt text of the asset.
  altText     String?  @map("alt_text")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  variant   PostVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  // An asset in use cannot be removed; the library asks to detach it first.
  asset     MediaAsset  @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([variantId, assetId])
  @@index([variantId, position])
  @@index([assetId])
  @@index([workspaceId])
  @@map("post_media")
}

// ---------------------------------------------------------------------------------------------
// Channels and publishing (guide step 4.1, architecture 4, 6.2 and 7): the connections to the
// platforms, the accounts they publish to, the log of publish attempts, the transactional
// outbox, incoming webhooks and the costs of paid API calls. Secrets are sealed envelopes
// (packages/crypto, guide step 4.2) with the AAD workspaceId:connectionId:field.
// ---------------------------------------------------------------------------------------------

// How a connection reaches its platform: the official API, the experimental browser of X
// (phase 6) or the mock adapter of development and tests.
enum ConnectionMethod {
  API
  BROWSER
  MOCK
}

enum ConnectionStatus {
  ACTIVE
  // The access runs out within 14 days and cannot be renewed automatically.
  EXPIRING
  NEEDS_REAUTH
  PAUSED
  REVOKED
}

// The kind of target: the profile of a person, a company or Facebook page, an Instagram
// professional account.
enum SocialAccountType {
  PROFILE
  PAGE
  BUSINESS
}

// One OAuth grant or browser session of a platform user in a workspace. Connecting the same
// platform user again updates it.
model SocialConnection {
  id                    String           @id @default(uuid(7)) @db.Uuid
  workspaceId           String           @map("workspace_id") @db.Uuid
  platform              Platform
  method                ConnectionMethod
  status                ConnectionStatus @default(ACTIVE)
  // Why the connection needs a new grant, for example REFRESH_FAILED or DEAUTHORIZED.
  statusReason          String?          @map("status_reason")
  // The platform user who granted the access, for example the OIDC sub on LinkedIn.
  externalUserId        String           @map("external_user_id")
  displayName           String           @map("display_name")
  accessTokenSealed     Bytes?           @map("access_token_sealed")
  refreshTokenSealed    Bytes?           @map("refresh_token_sealed")
  // The browser session of X (storageState), sealed with its own keyring (SESSION_KEKS).
  sessionSealed         Bytes?           @map("session_sealed")
  accessTokenExpiresAt  DateTime?        @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime?        @map("refresh_token_expires_at") @db.Timestamptz(3)
  // The scopes the platform granted; the UI names the ones missing from the request.
  scopes                String[]         @default([])
  // The last expiry reminder sent (14, 7 or 1 days ahead), so each stage goes out once.
  expiryNoticeDays      Int?             @map("expiry_notice_days")
  lastRefreshedAt       DateTime?        @map("last_refreshed_at") @db.Timestamptz(3)
  connectedById         String?          @map("connected_by_id") @db.Uuid
  version               Int              @default(0)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accounts  SocialAccount[]

  @@unique([workspaceId, platform, method, externalUserId])
  // tick.tokens (guide step 4.9) looks for access that runs out soon. Without a predicate: a
  // list of statuses comes back from Postgres as = ANY(...), which Prisma would see as drift.
  @@index([accessTokenExpiresAt], map: "social_connection_expiry_idx")
  @@map("social_connection")
}

// A target to publish to: a person, a company page, a Facebook page or an Instagram account.
// One connection can reach several, for example all pages of a Facebook user.
model SocialAccount {
  id                String            @id @default(uuid(7)) @db.Uuid
  workspaceId       String            @map("workspace_id") @db.Uuid
  connectionId      String            @map("connection_id") @db.Uuid
  platform          Platform
  type              SocialAccountType
  // The id of the target on the platform: a LinkedIn URN, a page id, an Instagram or X user id.
  externalId        String            @map("external_id")
  name              String
  handle            String?
  avatarUrl         String?           @map("avatar_url")
  // The token of a Facebook page, sealed like the tokens of the connection.
  accessTokenSealed Bytes?            @map("access_token_sealed")
  // Validated with zod; the mock adapter reads its latency and fail mode from here.
  settings          Json              @default("{}")
  // Disconnected accounts stay for the history of their posts.
  disconnectedAt    DateTime?         @map("disconnected_at") @db.Timestamptz(3)
  connectedById     String?           @map("connected_by_id") @db.Uuid
  version           Int               @default(0)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace      Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection     SocialConnection        @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  variants       PostVariant[]
  apiCostRecords ApiCostRecord[]
  snapshots      MetricSnapshot[]
  latestMetrics  PostMetricLatest[]
  accountMetrics AccountMetricSnapshot[]
  daily          AnalyticsDaily[]

  @@unique([workspaceId, platform, externalId])
  @@index([connectionId])
  @@map("social_account")
}

enum PublishAttemptOutcome {
  // Running, or left behind by a crashed worker: the next attempt reconciles first.
  STARTED
  PUBLISHED
  // The reconcile found the post of an earlier attempt on the platform.
  RECONCILED
  // Nothing was sent; meta holds the payload.
  DRY_RUN
  // Failed for now; the job tries again with backoff.
  RETRY
  FAILED
  // Sent, but the answer is missing; the reconcile or the user decides.
  UNKNOWN
}

// The log of every publish attempt (architecture 7, step 3 of the publish job).
model PublishAttempt {
  id              String                @id @default(uuid(7)) @db.Uuid
  workspaceId     String                @map("workspace_id") @db.Uuid
  variantId       String                @map("variant_id") @db.Uuid
  // The schedule version of the job, and the attempt within it.
  scheduleVersion Int                   @map("schedule_version")
  attemptNumber   Int                   @map("attempt_number")
  // schedule, now, retry or sweep.
  trigger         String
  outcome         PublishAttemptOutcome @default(STARTED)
  // The worker that held the lease.
  leaseOwner      String                @map("lease_owner")
  // A code of the error taxonomy (architecture 4.1), or for example MISSED_WINDOW.
  errorCode       String?               @map("error_code")
  // Without tokens or other secrets.
  errorMessage    String?               @map("error_message")
  externalPostId  String?               @map("external_post_id")
  // Platform details: the Instagram container ids for retries, the payload of a dry run.
  meta            Json                  @default("{}")
  startedAt       DateTime              @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime?             @map("finished_at") @db.Timestamptz(3)

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  variant   PostVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, scheduleVersion, attemptNumber])
  @@index([workspaceId])
  @@map("publish_attempt")
}

// The transactional outbox (architecture 7): written in the transaction of a change and turned
// into jobs or live events by tick.outbox-relay, which marks an event only after it went out.
model OutboxEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  // For example variant.publish-requested or notification.publish-failed.
  type        String
  payload     Json
  // The relay tries again after a failure, with a growing pause.
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([availableAt], map: "outbox_event_pending_idx", where: raw("processed_at IS NULL"))
  @@index([workspaceId])
  @@map("outbox_event")
}

// Incoming webhooks (Meta deauthorize and data deletion, later Stripe), stored once per event:
// providers send again until they get an answer, and processing must not run twice. Global,
// without a tenant: the worker resolves the affected connections as app_system.
model WebhookEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  // meta or stripe.
  provider    String
  // The id of the event at the provider, or the hash of its signed request.
  externalId  String    @map("external_id")
  type        String
  payload     Json
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)

  @@unique([provider, externalId])
  @@map("webhook_event")
}

// The cost of a paid platform call (X) in micro-USD, booked once per source and operation like
// the usage ledger. The accounts page shows it per workspace; the spend cap adds it up.
model ApiCostRecord {
  id              String   @id @default(uuid(7)) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  workspaceId     String?  @map("workspace_id") @db.Uuid
  socialAccountId String?  @map("social_account_id") @db.Uuid
  platform        Platform
  // The price key, for example x.post_create or x.media_upload.
  operation       String
  units           Int      @default(1)
  costMicros      BigInt   @map("cost_micros")
  // For example publish_attempt with its id.
  sourceType      String   @map("source_type")
  sourceId        String   @map("source_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace     Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)

  @@unique([sourceType, sourceId, operation])
  @@index([organizationId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("api_cost_record")
}

// ---------------------------------------------------------------------------------------------
// Analytics (guide step 5.1, architecture 6.2 and 8): the snapshots of the post metrics, the
// latest of them per variant, the daily numbers of the accounts and the rollup per account and
// day. Counters are cumulative and normalized across platforms; a metric the platform does not
// report is null, never 0.
// ---------------------------------------------------------------------------------------------

// One poll of the metrics of a published variant. Append-only for app_user: the raw answer and
// the version of its mapping stay, so the counters can be computed again when a mapping changes.
model MetricSnapshot {
  id              String   @id @default(uuid(7)) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  variantId       String   @map("variant_id") @db.Uuid
  socialAccountId String   @map("social_account_id") @db.Uuid
  platform        Platform
  // The step of the polling cascade; null for a manual refresh.
  step            Int?
  impressions     Int?
  reach           Int?
  views           Int?
  likes           Int?
  comments        Int?
  shares          Int?
  clicks          Int?
  saves           Int?
  raw             Json
  mappingVersion  Int      @map("mapping_version")
  capturedAt      DateTime @map("captured_at") @db.Timestamptz(3)

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  variant       PostVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  // The history of a variant, and the snapshots of a period for the rollup.
  @@index([variantId, capturedAt])
  @@index([workspaceId, capturedAt])
  @@map("metric_snapshot")
}

// The latest snapshot of each variant, for lists and top posts. Replaced only by a newer one.
model PostMetricLatest {
  variantId       String   @id @map("variant_id") @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  socialAccountId String   @map("social_account_id") @db.Uuid
  platform        Platform
  // Copied from the variant, so a period needs no join.
  publishedAt     DateTime @map("published_at") @db.Timestamptz(3)
  capturedAt      DateTime @map("captured_at") @db.Timestamptz(3)
  impressions     Int?
  reach           Int?
  views           Int?
  likes           Int?
  comments        Int?
  shares          Int?
  clicks          Int?
  saves           Int?
  // The sum of likes, comments, shares, saves and clicks; null when none of them is reported.
  engagements     Int?
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  variant       PostVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([workspaceId, publishedAt])
  @@map("post_metric_latest")
}

// The daily numbers of an account (architecture 8), polled around 03:00 in the time zone of the
// workspace for the day before. One row per account and day; another poll of the day replaces it.
model AccountMetricSnapshot {
  id              String   @id @default(uuid(7)) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  socialAccountId String   @map("social_account_id") @db.Uuid
  platform        Platform
  // The day in the time zone of the workspace the numbers describe.
  day             DateTime @db.Date
  followers       Int?
  reach           Int?
  profileViews    Int?     @map("profile_views")
  raw             Json
  mappingVersion  Int      @map("mapping_version")
  capturedAt      DateTime @map("captured_at") @db.Timestamptz(3)

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, day])
  @@index([workspaceId, day])
  @@map("account_metric_snapshot")
}

// The rollup per account and day in the time zone of the workspace (guide step 5.3): what the
// post counters grew between consecutive snapshots, the posts published that day and the daily
// numbers of the account. postReach adds up the reach of single posts, which overlaps; the
// dashboard names it so and prefers the reach of the account.
model AnalyticsDaily {
  workspaceId     String   @map("workspace_id") @db.Uuid
  socialAccountId String   @map("social_account_id") @db.Uuid
  platform        Platform
  day             DateTime @db.Date
  impressions     Int?
  postReach       Int?     @map("post_reach")
  views           Int?
  likes           Int?
  comments        Int?
  shares          Int?
  clicks          Int?
  saves           Int?
  engagements     Int?
  postsPublished  Int      @default(0) @map("posts_published")
  followers       Int?
  accountReach    Int?     @map("account_reach")
  profileViews    Int?     @map("profile_views")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@id([socialAccountId, day])
  @@index([workspaceId, day])
  @@map("analytics_daily")
}
