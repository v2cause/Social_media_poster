{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "generate": {
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["API_INTERNAL_URL"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["PLAYWRIGHT_CHROMIUM_EXECUTABLE", "STRIPE_TEST_CLOCK_SECRET_KEY"]
    },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": ["E2E_BASE_URL", "E2E_SHOTS_DIR", "PLAYWRIGHT_CHROMIUM_EXECUTABLE"]
    }
  }
}
